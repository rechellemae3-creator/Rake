		local t = LP:GetMouse().Target
		local m = t and t:FindFirstAncestorOfClass("Model")
		if m and (m == getRakoof() or m.Name:lower():find("rake")) then activateTool() end
	end))

	-- ---- INFINITE REACH ----
	heading(pCombat, "Reach")
	local reachDist = 100
	toggle(pCombat, "Infinite Reach", function(v)
		S.reach = v
		if v then
			runLoop("reach", function() return 0.1 end, function()
				local c = LP.Character
				local tool = c and c:FindFirstChildOfClass("Tool")
				local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
				local rk = getRakoof()
				local rp = rk and partOf(rk)
				if handle and rp and (handle.Position - rp.Position).Magnitude <= reachDist then
					if firetouchinterest then
						firetouchinterest(rp, handle, 0)
						firetouchinterest(rp, handle, 1)
					end
					tool:Activate()
				end
			end)
		end
	end)
	slider(pCombat, "Reach Distance", 5, 300, reachDist, function(v) reachDist = v end)

	-- ---- RAKOOF HITBOX ----
	heading(pCombat, "Rakoof Hitbox")
	local hbAll, hbShow, hbSize = false, true, 25
	local hbOriginal, hbModel = {}, nil

	local function hbRestore()
		for part, o in pairs(hbOriginal) do
			if part and part.Parent then
				pcall(function()
					part.Size = o.Size
					part.Transparency = o.Transparency
					part.CanCollide = o.CanCollide
					part.Massless = o.Massless
				end)
			end
		end
		hbOriginal, hbModel = {}, nil
	end
	restoreHitbox = hbRestore

	local function hbApply(part)
		if not hbOriginal[part] then
			hbOriginal[part] = {
				Size = part.Size,
				Transparency = part.Transparency,
				CanCollide = part.CanCollide,
				Massless = part.Massless,
			}
		end
		local o = hbOriginal[part]
		local want = o.Size + Vector3.new(hbSize, hbSize, hbSize)
		if part.Size ~= want then part.Size = want end
		part.CanCollide = false
		part.Massless = true
		part.Transparency = hbShow and math.max(0.55, o.Transparency) or o.Transparency
	end

	task.spawn(function()
		while alive do
			task.wait(0.25)
			if S.hb then
				local m = getRakoof()
				if m then
					if hbModel ~= m then
						hbRestore()
						hbModel = m
					end
					if hbAll then
						for _, p in ipairs(m:GetDescendants()) do
							if p:IsA("BasePart") then pcall(hbApply, p) end
						end
					else
						local rp = partOf(m)
						if rp then pcall(hbApply, rp) end
					end
				elseif hbModel then
					hbRestore()
				end
			end
		end
	end)

	toggle(pCombat, "Expand Rakoof Hitbox", function(v)
		S.hb = v
		if not v then hbRestore() end
	end)
	slider(pCombat, "Hitbox Size", 1, 100, hbSize, function(v) hbSize = v end)
	local setHbShow = toggle(pCombat, "Show Hitbox", function(v)
		hbShow = v
		if S.hb then hbRestore() end
	end)
	setHbShow(true)
	toggle(pCombat, "All Parts", function(v)
		hbAll = v
		if S.hb then hbRestore() end
	end)

	-- ---- AIM LOCK ----
	heading(pCombat, "Aim Lock")
	local aimStrength, aimHead = 100, false
	local aimTarget, aimPart, aimAt = nil, nil, 0
	local AIM_BIND = "eva_aim_" .. tostring(math.random(1000, 9999))

	local function aimStep()
		local cm = WS.CurrentCamera
		local root = getRoot()
		if not cm or not root then return end
		if tick() - aimAt > 0.25 or not (aimPart and aimPart.Parent) then
			aimAt = tick()
			aimTarget, aimPart = pickTarget(root, false)
		end
		if not aimPart then return end
		local pos = aimPart.Position
		if aimHead and aimTarget then
			local h = aimTarget:FindFirstChild("Head")
			if h and h:IsA("BasePart") then pos = h.Position end
		end
		local goal = CFrame.new(cm.CFrame.Position, pos)
		local a = aimStrength / 100
		cm.CFrame = (a >= 1) and goal or cm.CFrame:Lerp(goal, a)
	end

	stopAim = function()
		S.aim = false
		pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
	end

	toggle(pCombat, "Aim Lock (Rakoof)", function(v)
		stopAim()
		if not v then return end
		S.aim = true
		aimAt = 0
		local ok = pcall(function()
			RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 1, aimStep)
		end)
		if ok then
			notify("Aim lock on")
		else
			S.aim = false
			notify("Aim lock failed to start")
		end
	end)
	slider(pCombat, "Lock Strength", 5, 100, aimStrength, function(v) aimStrength = v end)
	toggle(pCombat, "Aim at Head", function(v) aimHead = v end)

	-- ---- TELEPORT ----
	heading(pCombat, "Teleport")
	button(pCombat, "Teleport to Rakoof", function()
		local m = getRakoof()
		if not m then notify("Rakoof not found") return end
		local root = getRoot()
		if not root then return end
		local ok, cf = pcall(function() return m:GetPivot() end)
		if not ok then notify("Couldn't read Rakoof's position") return end
		local target = cf.Position + (cf.LookVector * -1) * S.standDist + Vector3.new(0, 2, 0)
		root.CFrame = CFrame.new(target, cf.Position)
		root.AssemblyLinearVelocity = Vector3.zero
		aiPauseUntil = tick() + 1.5
	end)

	-- ---- BOSS MODE ----
	heading(pCombat, "Boss Mode")
	button(pCombat, "Trigger StartMode (remote)", function()
		local hits = findRemote({"StartMode", "startmode", "StartModeRemote"})
		if #hits == 0 then notify("No StartMode remote found") return end
		for _, r in ipairs(hits) do
			pcall(function()
				if r:IsA("RemoteEvent") then
					r:FireServer("HellsAwakening")
					r:FireServer("HellsAwakeningMain")
				elseif r:IsA("RemoteFunction") then
					r:InvokeServer("HellsAwakening")
				elseif r:IsA("BindableEvent") then
					r:Fire("HellsAwakening")
				end
			end)
		end
	end)

	inputButton(pCombat, "Script name", "MainBloodHour", "START", function(text)
		local target = (text:gsub("%s+", ""))
		if target == "" then notify("Type a script name first") return end
		local found = false
		for _, obj in ipairs(WS:GetDescendants()) do
			if obj.Name == target then
				found = true
				pcall(function()
					if obj:IsA("Script") or obj:IsA("LocalScript") then
						obj.Disabled = true
						task.wait(0.05)
						obj.Disabled = false
					end
				end)
				pcall(function()
					if typeof(getsenv) == "function" then
						local e = getsenv(obj)
						if e and e.Start then e.Start() end
					end
				end)
			end
		end
		notify(found and "Started" or "Not found")
	end)
end)

-- ============ RAKE TAB ============
-- Built from a workspace dump of this game. What the dump showed:
--   * Workspace.The_Rake has a Humanoid called "NPC", a "Hitbox" part in collision group Default,
--     and body parts in collision group "RakOOF". Boss health is Workspace.RakoofHP / RakoofMaxHP.
--   * The melee tools (CorruptedSword, UltraFish) carry a Configuration folder (Cooldown, Damage,
--     HitCD, Waste, AddGetStuns), a Handle, and a Cooldown RemoteEvent that the SERVER fires at you.
--     Their hit code is a server Script, so nothing here can be proven from the dump. Every melee
--     option below is a best-effort experiment, and the DPS meter tells you which ones really land.
--   * Workspace.RewardUIValues.MinDPS is the damage rate needed to qualify for boss rewards.
guard("rake", function()
	local fmt
	local readValue
	local getBoss
	local bossHealth
	local equippedTool
	local toolHandle
	local toolNumber

	-- ---------- small helpers ----------
	fmt = function(n)
		local s = tostring(math.floor(math.max(0, n or 0) + 0.5))
		local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		return (out:gsub("^,", ""))
	end

	readValue = function(parent, name)
		local v = parent and parent:FindFirstChild(name)
		if v and v:IsA("ValueBase") then
			local ok, val = pcall(function() return v.Value end)
			if ok then return val end
		end
		return nil
	end

	getBoss = function()
		local m = WS:FindFirstChild("The_Rake")
		if m and m:IsA("Model") then return m end
		return getRakoof()
	end

	local function hitboxOf(boss)
		if not boss then return nil end
		local hb = boss:FindFirstChild("Hitbox")
		if hb and hb:IsA("BasePart") then return hb end
		return partOf(boss)
	end

	bossHealth = function()
		local hp = readValue(WS, "RakoofHP")
		if type(hp) == "number" then
			local max = readValue(WS, "RakoofMaxHP")
			return hp, (type(max) == "number" and max or 0)
		end
		local boss = getBoss()
		local hum = boss and boss:FindFirstChildOfClass("Humanoid")
		if hum then return hum.Health, hum.MaxHealth end
		return nil, nil
	end

	equippedTool = function()
		local c = LP.Character
		return c and c:FindFirstChildOfClass("Tool")
	end

	toolHandle = function(tool)
		return tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
	end

	-- reads Configuration.<name> from a weapon (the dump shows Cooldown, Damage, HitCD, Waste, AddGetStuns)
	toolNumber = function(tool, name, default)
		local val = readValue(tool and tool:FindFirstChild("Configuration"), name)
		if type(val) == "number" then return val end
		return default
	end

	local function short(v)
		if type(v) ~= "number" then return tostring(v) end
		return tostring(math.floor(v * 100 + 0.5) / 100)
	end

	local function tpTo(inst, up)
		local root = getRoot()
		if not root or not inst then return end
		local ok, cf = pcall(function()
			if inst:IsA("BasePart") then return inst.CFrame end
			return inst:GetPivot()
		end)
		if not ok then notify("Can't read that location") return end
		root.CFrame = cf + Vector3.new(0, up or 4, 0)
		root.AssemblyLinearVelocity = Vector3.zero
		aiPauseUntil = tick() + 1.5
	end

	-- ---------- LIVE STATUS ----------
	heading(pRake, "Boss Status")
	local hpLine = liveInfo(pRake, "Rakoof HP: waiting...")
	local dpsLine = liveInfo(pRake, "DPS: waiting...")
	local modeLine = liveInfo(pRake, "Mode: waiting...")
	local weaponLine = liveInfo(pRake, "Weapon: waiting...")

	-- ---------- MELEE LAB ----------
	heading(pRake, "Melee Lab")
	info(pRake, "Equip a melee tool and stand near the Rake, then watch the DPS line.")
	info(pRake, "A method that lands moves it. One that does nothing leaves it at 0.")

	local swingAt = 0
	local cdState = setmetatable({}, {__mode = "k"})
	local watched = setmetatable({}, {__mode = "k"})
	local swingMs, swingRange = 0, 30
	local pulseMs, auraReach, auraWindow = 60, 25, 0.8
	local warpWindow, warpRange = 0.6, 40
	local touchAll = false

	-- remembers when the tool was swung (by you or by this script) and the text the
	-- server sends through the tool's Cooldown event
	local function watchTool(tool)
		if watched[tool] then return end
		watched[tool] = true
		local state = {text = "", at = 0}
		cdState[tool] = state
		local ev = tool:FindFirstChild("Cooldown")
		if ev and ev:IsA("RemoteEvent") then
			track(ev.OnClientEvent:Connect(function(text)
				state.text, state.at = tostring(text), os.clock()
			end))
		end
		track(tool.Activated:Connect(function() swingAt = os.clock() end))
	end

	-- true while the server's last Cooldown message was a number above zero
	local function serverCooling(tool)
		local st = cdState[tool]
		if not st or os.clock() - st.at > 0.4 then return false end
		local n = tonumber(st.text:match("%d+%.?%d*"))
		return n ~= nil and n > 0.05
	end

	local function swingInterval(tool)
		if swingMs > 0 then return swingMs / 1000 end
		return math.max(toolNumber(tool, "Cooldown", 0), 0.12)
	end

	-- the best melee weapon is the tool with the highest Configuration.Damage
	local function bestMelee()
		local best, bestDmg = nil, -1
		for _, container in ipairs({LP.Character, LP:FindFirstChildOfClass("Backpack")}) do
			if container then
				for _, t in ipairs(container:GetChildren()) do
					if t:IsA("Tool") and toolHandle(t) and t:FindFirstChild("Configuration") then
						local dmg = toolNumber(t, "Damage", 0)
						if dmg > bestDmg then best, bestDmg = t, dmg end
					end
				end
			end
		end
		return best
	end

	local function equipBest()
		local _, hum = getRoot()
		local tool = bestMelee()
		if hum and tool and tool.Parent ~= LP.Character then
			pcall(function() hum:EquipTool(tool) end)
		end
	end

	local function bossDistance(from)
		local part = hitboxOf(getBoss())
		if not part or not from then return math.huge end
		return (part.Position - from).Magnitude
	end

	-- 1) swing exactly when the weapon is ready instead of spamming every frame
	toggle(pRake, "Auto Swing (cooldown aware)", function(v)
		S.rkSwing = v
		if not v then return end
		runLoop("rkSwing", function() return swingInterval(equippedTool()) end, function()
			local root = getRoot()
			if not root then return end
			local tool = equippedTool()
			if not tool then
				if S.rkAutoEquip then equipBest() end
				return
			end
			watchTool(tool)
			if S.rkNearOnly and bossDistance(root.Position) > swingRange then return end
			if serverCooling(tool) then return end
			swingAt = os.clock()
			tool:Activate()
		end)
	end)
	local setEquip = toggle(pRake, "Auto Equip Best Melee", function(v) S.rkAutoEquip = v end)
	setEquip(true)
	local setNear = toggle(pRake, "Only Swing Near Rakoof", function(v) S.rkNearOnly = v end)
	setNear(true)
	slider(pRake, "Swing Range (studs)", 5, 150, swingRange, function(v) swingRange = v end)
	slider(pRake, "Swing Interval (ms, 0 = weapon cooldown)", 0, 2000, swingMs, function(v) swingMs = v end)

	-- 2) touch pulses between the weapon and the Rake's real Hitbox part
	local function toolParts(tool)
		local parts = {}
		local handle = toolHandle(tool)
		if handle then parts[#parts + 1] = handle end
		if touchAll then
			for _, d in ipairs(tool:GetDescendants()) do
				if d:IsA("BasePart") and d ~= handle then parts[#parts + 1] = d end
			end
		else
			local shock = tool:FindFirstChild("ShockPart", true)
			if shock and shock:IsA("BasePart") then parts[#parts + 1] = shock end
		end
		return parts
	end

	local function bossParts(boss)
		local list = {}
		for _, name in ipairs({"Hitbox", "HumanoidRootPart", "Torso", "Head"}) do
			local p = boss:FindFirstChild(name)
			if p and p:IsA("BasePart") then list[#list + 1] = p end
		end
		return list
	end

	toggle(pRake, "Touch Pulse Aura", function(v)
		S.rkAura = v
		if not v then return end
		if not firetouchinterest then notify("Your executor has no firetouchinterest") end
		runLoop("rkAura", function() return pulseMs / 1000 end, function()
			if not firetouchinterest then return end
			if S.rkAuraSync and os.clock() - swingAt > auraWindow then return end
			local tool = equippedTool()
			local boss = getBoss()
			if not tool or not boss then return end
			watchTool(tool)
			local targets = bossParts(boss)
			for _, tp in ipairs(toolParts(tool)) do
				for _, bp in ipairs(targets) do
					if (tp.Position - bp.Position).Magnitude <= auraReach then
						pcall(firetouchinterest, tp, bp, 0)
						pcall(firetouchinterest, tp, bp, 1)
					end
				end
			end
		end)
	end)
	local setSync = toggle(pRake, "Pulse Only Right After A Swing", function(v) S.rkAuraSync = v end)
	setSync(true)
	toggle(pRake, "Pulse From Every Tool Part", function(v) touchAll = v end)
	slider(pRake, "Pulse Reach (studs)", 5, 120, auraReach, function(v) auraReach = v end)
	slider(pRake, "Pulse Every (ms)", 20, 500, pulseMs, function(v) pulseMs = v end)

	-- 3) experimental: during a swing, detach the weapon's grip and put the Handle on the
	-- Rake's Hitbox. Only the weapon moves, you stay where you are. The grip is switched
	-- back on as soon as the swing window ends.
	local warpActive, warpJoints = false, {}

	local function warpEnd()
		for _, j in ipairs(warpJoints) do
			pcall(function() j.Enabled = true end)
		end
		warpJoints, warpActive = {}, false
	end
	onCleanup(warpEnd)

	local function gripJoints(handle)
		local list = {}
		local char = LP.Character
		if not char then return list end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("JointInstance") and (d.Part0 == handle or d.Part1 == handle) then
				list[#list + 1] = d
			end
		end
		return list
	end

	track(RunService.Heartbeat:Connect(function()
		if not S.rkWarp then
			if warpActive then warpEnd() end
			return
		end
		local root = getRoot()
		local handle = toolHandle(equippedTool())
		local hb = hitboxOf(getBoss())
		local ready = root and handle and hb
			and os.clock() - swingAt <= warpWindow
			and (root.Position - hb.Position).Magnitude <= warpRange
		if not ready then
			if warpActive then warpEnd() end
			return
		end
		if not warpActive then
			warpActive = true
			warpJoints = gripJoints(handle)
			for _, j in ipairs(warpJoints) do
				pcall(function() j.Enabled = false end)
			end
		end
		handle.CFrame = hb.CFrame
		handle.AssemblyLinearVelocity = Vector3.zero
	end))

	toggle(pRake, "Handle Warp (experimental)", function(v)
		S.rkWarp = v
		if not v and warpActive then warpEnd() end
	end)
	slider(pRake, "Warp Window After Swing (ms)", 100, 1500, math.floor(warpWindow * 1000), function(v) warpWindow = v / 1000 end)
	slider(pRake, "Warp Only Within (studs)", 5, 150, warpRange, function(v) warpRange = v end)
	info(pRake, "Tip: in Combat, turn on All Parts under Expand Rakoof Hitbox to include the real Hitbox part.")
	info(pRake, "Keep Stand Distance low (3-5) so the sword actually reaches.")

	-- ---------- SURVIVAL ----------
	heading(pRake, "Survival")
	local lowHp, nearDist, escapePause, lastEscape = 35, 18, 4, 0

	-- spots from Workspace.LocationsIndicator that are not caves (the caves have anti-camp zones)
	local SAFE_SPOTS = {"SafeHouse", "Tower", "Cabin", "Cabin2", "Shop", "ClydeHouse"}

	local function escapeNow()
		local root = getRoot()
		if not root then return false end
		local folder = WS:FindFirstChild("LocationsIndicator")
		local bp = hitboxOf(getBoss())
		local best, bestD = nil, -1
		for _, name in ipairs(SAFE_SPOTS) do
			local p = folder and folder:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				local d = (p.Position - (bp and bp.Position or root.Position)).Magnitude
				if d > bestD then best, bestD = p, d end
			end
		end
		if not best then
			lastEscape = tick()
			notify("No safe spot found")
			return false
		end
		root.CFrame = best.CFrame + Vector3.new(0, 5, 0)
		root.AssemblyLinearVelocity = Vector3.zero
		aiPauseUntil = tick() + escapePause
		lastEscape = tick()
		return true
	end

	button(pRake, "Escape Now (farthest safe spot)", function()
		if escapeNow() then notify("Escaped") end
	end)

	toggle(pRake, "Escape On Low HP", function(v)
		S.rkEscHp = v
		if not v then return end
		runLoop("rkEscHp", function() return 0.2 end, function()
			local _, hum = getRoot()
			if not hum or hum.MaxHealth <= 0 or hum.Health <= 0 then return end
			if hum.Health / hum.MaxHealth * 100 <= lowHp and tick() - lastEscape > 5 then
				if escapeNow() then notify("Escaped (low HP)") end
			end
		end)
	end)
	slider(pRake, "Escape Below HP %", 5, 90, lowHp, function(v) lowHp = v end)

	toggle(pRake, "Escape When Rakoof Is Near", function(v)
		S.rkEscNear = v
		if not v then return end
		runLoop("rkEscNear", function() return 0.2 end, function()
			local root = getRoot()
			if not root or tick() - lastEscape < 5 then return end
			if bossDistance(root.Position) <= nearDist then
				if escapeNow() then notify("Escaped (Rakoof near)") end
			end
		end)
	end)
	slider(pRake, "Near Distance (studs)", 5, 80, nearDist, function(v) nearDist = v end)
	slider(pRake, "Pause Combat After Escape (s)", 1, 15, escapePause, function(v) escapePause = v end)
	info(pRake, "Do not combine 'Escape When Near' with Auto Rakoof. It stands next to the Rake.")

	-- ---------- PICKUPS AND LEVERS ----------
	heading(pRake, "Pickups")

	toggle(pRake, "Auto Free Chips", function(v)
		S.rkChips = v
		if not v then return end
		runLoop("rkChips", function() return 3 end, function()
			local root = getRoot()
			local misc = WS:FindFirstChild("Misc")
			local spawns = misc and misc:FindFirstChild("LaysSpawns")
			if not root or not spawns then return end
			if bossDistance(root.Position) < 60 then return end
			for _, p in ipairs(spawns:GetDescendants()) do
				if not S.rkChips then break end
				if p:IsA("ProximityPrompt") and p.Enabled and p.Parent and p.Parent:IsA("BasePart") then
					local origin = root.CFrame
					aiPauseUntil = tick() + 1
					root.CFrame = p.Parent.CFrame + Vector3.new(0, 3, 0)
					task.wait(0.15)
					pcall(fireproximityprompt, p)
					task.wait(0.2)
					root.CFrame = origin
				end
			end
		end)
	end)

	-- ClickDetector paths taken from the dump
	local LEVERS = {
		{"Tower Lever", {"Tower", "Lever", "Click"}},
		{"Ranger Office Light Lever", {"RangerOffice", "LightLever", "Bar"}},
		{"Ranger Office Door Lever", {"RangerOffice", "SlidingDoor", "ScriptedComponents", "Lever", "Detect"}},
		{"Cabin Light Lever", {"RemasteredCabin", "Structure", "LightLever", "Bar"}},
	}

	heading(pRake, "Levers (each click toggles)")
	for _, lever in ipairs(LEVERS) do
		button(pRake, "Click " .. lever[1], function()
			if not fireclickdetector then notify("Your executor has no fireclickdetector") return end
			local cur = WS
			for _, n in ipairs(lever[2]) do cur = cur and cur:FindFirstChild(n) end
			local cd = cur and cur:FindFirstChildOfClass("ClickDetector")
			if not cd then notify(lever[1] .. " not found") return end
			pcall(fireclickdetector, cd)
		end)
	end

	-- ---------- ESP ----------
	heading(pRake, "ESP")
	local tag = nil
	local itemHL = {}

	local function clearTag()
