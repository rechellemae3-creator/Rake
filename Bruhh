local function hop()
	while not stopped and CONFIG.hops < CONFIG.maxHops and #CONFIG.ids > 0 do
		local id = table.remove(CONFIG.ids, 1)

		if id ~= game.JobId then
			CONFIG.hops += 1
			setStatus(string.format("Hop %d/%d, %d servers left...", CONFIG.hops, CONFIG.maxHops, #CONFIG.ids))

			local failed = false

			local connection = teleportService.TeleportInitFailed:Connect(function()
				failed = true
			end)

			queueSelf()

			if not pcall(teleportService.TeleportToPlaceInstance, teleportService, game.PlaceId, id, localPlayer) then
				failed = true
			end

			-- Wait until the teleport takes us away or fails.
			local timeout = os.clock() + 25

			while not failed and not stopped and os.clock() < timeout do
				task.wait(0.25)
			end

			connection:Disconnect()

			if stopped then
				return
			end

			if not failed then
				return finish("Teleport timed out.", WARN)
			end

			task.wait(CONFIG.delay + 3)
		end
	end

	if not stopped then
		finish("Out of servers or hops. Press Start again.", WARN)
	end
end

