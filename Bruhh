---Build the draggable window.
local function createGui()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = string.format("%x", math.random(0x1000000, 0x7ffffff))
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 999
	screenGui.Parent = (gethui and gethui()) or coreGui

	local window = Instance.new("Frame")
	window.Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT)
	window.Position = UDim2.new(0.5, -WINDOW_WIDTH / 2, 0.5, -WINDOW_HEIGHT / 2)
	window.BackgroundColor3 = COLOR_BACKGROUND
	window.BorderSizePixel = 0
	window.Parent = screenGui
	corner(window, 8)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 30)
	title.BackgroundColor3 = COLOR_PANEL
	title.BorderSizePixel = 0
	title.Text = "Baon Hub"
	title.TextColor3 = COLOR_TEXT
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.Parent = window
	corner(title, 8)

	local closeButton = Instance.new("TextButton")
	closeButton.Size = UDim2.fromOffset(24, 22)
	closeButton.Position = UDim2.new(1, -30, 0, 4)
	closeButton.BackgroundColor3 = COLOR_RED
	closeButton.BorderSizePixel = 0
	closeButton.Text = "x"
	closeButton.TextColor3 = COLOR_TEXT
	closeButton.Font = Enum.Font.GothamBold
	closeButton.TextSize = 13
	closeButton.Parent = title
	corner(closeButton, 5)
	track(closeButton.MouseButton1Click:Connect(function()
		BaonHub.detach()
	end))

	local sidebar = Instance.new("Frame")
	sidebar.Size = UDim2.new(0, SIDEBAR_WIDTH, 1, -40)
	sidebar.Position = UDim2.fromOffset(6, 34)
	sidebar.BackgroundColor3 = COLOR_PANEL
	sidebar.BorderSizePixel = 0
	sidebar.Parent = window
	corner(sidebar, 6)

	local sidebarLayout = Instance.new("UIListLayout")
	sidebarLayout.Padding = UDim.new(0, 4)
	sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	sidebarLayout.Parent = sidebar

	local sidebarPadding = Instance.new("UIPadding")
	sidebarPadding.PaddingTop = UDim.new(0, 6)
	sidebarPadding.PaddingLeft = UDim.new(0, 6)
	sidebarPadding.PaddingRight = UDim.new(0, 6)
	sidebarPadding.Parent = sidebar

	local pageHost = Instance.new("Frame")
	pageHost.Size = UDim2.new(1, -SIDEBAR_WIDTH - 18, 1, -40)
	pageHost.Position = UDim2.fromOffset(SIDEBAR_WIDTH + 12, 34)
	pageHost.BackgroundTransparency = 1
	pageHost.Parent = window

	interface.screenGui = screenGui
	interface.window = window
	interface.sidebar = sidebar
	interface.pageHost = pageHost

	-- Dragging.
	local dragging = false
	local dragStart = nil
	local startPosition = nil

	track(title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = window.Position
		end
	end))

	track(userInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			window.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end))

	track(userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

---Initialize the script.
function BaonHub.init()
	createGui()
	buildPages()

	-- Per-frame player features.
	track(runService.Heartbeat:Connect(function()
		local humanoid = getHumanoid()

		if humanoid and flags.speed then
			humanoid.WalkSpeed = settings.walkSpeed
		end

		if humanoid and flags.jump then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = settings.jumpPower
		end
	end))

	track(runService.Stepped:Connect(function()
		local character = localPlayer.Character

		if not flags.noclip or not character then
			return
		end

		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end))

	track(userInputService.JumpRequest:Connect(function()
		local humanoid = getHumanoid()

		if flags.infiniteJump and humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end))

	track(localPlayer.Idled:Connect(function()
		if flags.antiAfk then
			virtualUser:CaptureController()
			virtualUser:ClickButton2(Vector2.new())
		end
	end))

	track(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or userInputService:GetFocusedTextBox() then
			return
		end

		if input.KeyCode == TOGGLE_KEY then
			setStealToggle(not flags.steal)
		elseif input.KeyCode == HIDE_KEY then
			interface.window.Visible = not interface.window.Visible
		end
	end))
end

---Detach the script and undo everything it changed.
function BaonHub.detach()
	alive = false
	table.clear(flags)

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end

	table.clear(connections)
	clearEsp()
	setFullBright(false)

	local humanoid = getHumanoid()

	if humanoid then
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50
	end

	if interface.screenGui then
		interface.screenGui:Destroy()
	end

	shared[SHARED_KEY] = nil
end

---This is called when initialization errors.
---@param errorMessage string
local function onInitializeError(errorMessage)
	warn("Failed to initialize.")
	warn(errorMessage)
	warn(debug.traceback())
	BaonHub.detach()
end

-- Detach the previous instance before attaching this one.
if shared[SHARED_KEY] then
	shared[SHARED_KEY].detach()
end

shared[SHARED_KEY] = BaonHub

-- Safely initialize the script and handle errors.
xpcall(BaonHub.init, onInitializeError)
