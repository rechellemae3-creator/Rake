		return value == true or (type(value) == "number" and value > 0)
	end

	---Read the PityChaos state of this server.
	---@return table
	local function readPity()
		local folder = findPityFolder()

		if not folder then
			return { found = false, active = false, detail = "workspace." .. table.concat(PITY_PATH, ".") }
		end

		local active = false
		local parts = {}

		for _, name in ipairs(PITY_FLAGS) do
			local value = readPityValue(folder, name)
			active = active or isOn(value)
			table.insert(parts, string.format("%s: %s", name, tostring(value)))
		end

		table.insert(parts, string.format("%s: %s", PITY_CYCLE, tostring(readPityValue(folder, PITY_CYCLE))))

		return { found = true, active = active, detail = table.concat(parts, "  |  ") }
	end

