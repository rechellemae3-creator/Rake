	info(pRake, "Cave1 and Cave2 sit next to the game's anti-camp zones. Do not stay in them.")

	local names = {"Shop", "Tower", "SafeHouse", "Cabin", "Cabin2", "ClydeHouse", "ChaosMachine", "Cave1", "Cave2"}
	local known = {}
	for _, n in ipairs(names) do known[n] = true end
	local locs = WS:FindFirstChild("LocationsIndicator")
	if locs then
		for _, p in ipairs(locs:GetChildren()) do
			if p:IsA("BasePart") and not known[p.Name] then
				known[p.Name] = true
				names[#names + 1] = p.Name
			end
