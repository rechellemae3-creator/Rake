	local REMOTE_KEYWORDS = { "shoot", "fire", "hit", "damage", "bullet", "gun", "tase" }
	local HOOK_KEY = "sa_4c91e0"
	local SERIALIZER_URL = "https://raw.githubusercontent.com/Awakenchan/GcViewerV2/refs/heads/main/Utility/Data2Code%40Amity.lua"
	local SILENT_KEY = Enum.KeyCode.RightControl
	local DAMAGE_KEY = Enum.KeyCode.RightAlt
	local WATCHED_METHODS = {
		Raycast = true,
		FindPartOnRay = true,
		FindPartOnRayWithIgnoreList = true,
		FindPartOnRayWithWhitelist = true,
		FireServer = true,
		InvokeServer = true,
	}

	-- State.
	local setNamecallMethod = setnamecallmethod or function() end
	local serializer = nil
	local statusLabel = nil
	local setSilent = nil
	local setDamage = nil

	local config = {
		toolName = "KillerTaser",
		targetName = "",
		hitChance = 100,
		maxDistance = 600,
		ignoreWalls = false,
		strictCaller = true,
		damageInterval = 0.05,
		damageBurst = 4,
		debug = false,
	}

	local state = {
		target = nil,
		lastSearch = 0,
		lastRoll = 0,
		lastRollHit = true,
		nextDamage = 0,
		templates = {},
		templateCount = 0,
	}

	S.silentAim = false
	S.autoDamage = false

	-- The hook survives re-execution, so its state lives in the executor environment.
	local hookState = env[HOOK_KEY]

	if not hookState then
		hookState = { installed = false, handler = nil }
		env[HOOK_KEY] = hookState
	end

	---Load the Data2Code serializer through the custom request function.
	---@return table?
	local function loadSerializer()
		local success, result = pcall(function()
			local response = request({ Url = SERIALIZER_URL, Method = "GET" })
			return loadstring(response.Body)()
		end)

		if success and type(result) == "table" then
			return result
		end
	end

	---Print a labeled value while debugging.
	---@param label string
	---@param value any
	local function debugPrint(label, value)
		local text = tostring(value)

		if serializer then
			local success, result = pcall(serializer.Convert, value, true)
			text = success and tostring(result) or text
		end

		print(string.format("[SilentAim] %s\n%s", label, text))
	end

	---Get the equipped gun matching config.toolName (empty accepts any tool).
	---@return Tool?
	local function getEquippedTool()
		local character = LP.Character
		local tool = character and character:FindFirstChildOfClass("Tool")

		if not tool then
			return nil
		end

		if config.toolName ~= "" and tool.Name ~= config.toolName then
			return nil
		end

		return tool
	end

	---Find the target model, retrying at most once per second.
	---@return Instance?
	local function findTarget()
		local target = state.target

		if target and target.Parent and validTarget(target) then
			return target
		end

		local now = os.clock()

		if now - state.lastSearch < 1 then
			return nil
		end

		state.lastSearch = now

		if config.targetName ~= "" then
			state.target = WS:FindFirstChild(config.targetName) or WS:FindFirstChild(config.targetName, true)
		else
			state.target = getRakoof() or WS:FindFirstChild(FALLBACK_TARGET) or WS:FindFirstChild(FALLBACK_TARGET, true)
		end

		return state.target
	end

	---Pick the part of the target to aim at.
	---@param model Instance
	---@return BasePart?
	local function pickAimPart(model)
		if model:IsA("BasePart") then
			return model
		end

		for _, name in ipairs(AIM_PARTS) do
			local part = model:FindFirstChild(name)

			if part and part:IsA("BasePart") then
				return part
			end
		end

		return (model:IsA("Model") and model.PrimaryPart) or model:FindFirstChildWhichIsA("BasePart", true)
	end

	---Resolve the target's aim point.
	---@return table?
	local function getAim()
		local model = findTarget()

		if not model then
			return nil
		end

		local part = pickAimPart(model)

		if not part then
			return nil
		end

		return {
			model = model,
			part = part,
			position = part.Position,
			humanoid = model:FindFirstChildOfClass("Humanoid"),
		}
	end

	---Check whether a vector is unit length, which means it is a direction.
	---@param vector Vector3
	---@return boolean
	local function isDirection(vector)
		return math.abs(vector.Magnitude - 1) < 0.02
	end

	---Check whether a remote looks like part of the gun.
	---@param remote Instance
	---@param tool Tool
	---@return boolean
	local function isGunRemote(remote, tool)
		if remote:IsDescendantOf(tool) then
			return true
		end

		local lowered = string.lower(remote.Name)

		for _, keyword in ipairs(REMOTE_KEYWORDS) do
			if string.find(lowered, keyword, 1, true) then
				return true
			end
		end

		return false
	end

	---Check whether the current call comes from the gun's scripts.
	---@param tool Tool
	---@param remote Instance?
	---@return boolean
	local function isGunCall(tool, remote)
		if not config.strictCaller then
			return true
		end

		local callingScript = getcallingscript and getcallingscript()

		if typeof(callingScript) == "Instance" then
			return callingScript:IsDescendantOf(tool)
		end

		return remote ~= nil and isGunRemote(remote, tool)
	end

	---Roll the hit chance once per shot so every call of that shot agrees.
	---@return boolean
	local function rollHit()
		local now = os.clock()

		if now - state.lastRoll > 0.2 then
			state.lastRoll = now
			state.lastRollHit = math.random(1, 100) <= config.hitChance
		end

		return state.lastRollHit
	end

	---Build a rewrite context for the current character, tool and target.
	---@param tool Tool
	---@return table?
	local function buildContext(tool)
		local character = LP.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local aim = getAim()

		if not root or not aim then
			return nil
		end

		if (aim.position - root.Position).Magnitude > config.maxDistance then
			return nil
		end

		local handle = tool:FindFirstChild("Handle")
		local origin = (handle and handle:IsA("BasePart")) and handle.Position or root.Position

		return {
			tool = tool,
			character = character,
			aim = aim,
			rootPosition = root.Position,
			currentRoot = root.Position,
			currentOrigin = origin,
			origin = origin,
			shift = Vector3.zero,
			changed = false,
			touched = false,
		}
	end

	---Resolve the context for a live gun call.
	---@param remote Instance?
	---@return table?
	local function resolveContext(remote)
		local tool = getEquippedTool()

		if not tool or not isGunCall(tool, remote) then
			return nil
		end

		local context = buildContext(tool)

		if not context or not rollHit() then
			return nil
		end

		return context
	end

	---Build a direction toward the aim point that is at least as long as the original.
	---@param context table
	---@param origin Vector3
	---@param length number
	---@return Vector3?
	local function aimDirection(context, origin, length)
		local delta = context.aim.position - origin

		if delta.Magnitude < 0.1 then
			return nil
		end

		return delta.Unit * math.max(length, delta.Magnitude + 2)
	end

	---Build raycast params that only see the aim part.
	---@param part BasePart
	---@return RaycastParams
	local function includeParams(part)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { part }
		return params
	end

	---Rewrite one value so it points at the target.
	---@param value any
	---@param context table
	---@param depth number
	---@return any
	local function rewriteValue(value, context, depth)
		local valueType = typeof(value)

		if valueType == "Instance" then
			if value == context.tool or value == context.character then
				return value
			end

			if value:IsDescendantOf(context.tool) or value:IsDescendantOf(context.character) then
				return value
			end

			local replacement = value

			if value:IsA("Humanoid") then
				context.touched = true
				replacement = context.aim.humanoid or value
			elseif value:IsA("BasePart") then
				context.touched = true
				replacement = context.aim.part
			elseif value:IsA("Model") then
				context.touched = true
				replacement = context.aim.model
			end

			if replacement ~= value then
				context.changed = true
			end

			return replacement
		end

		if valueType == "Vector3" then
			if value.Magnitude < 0.01 then
				return value
			end

			local replacement = value

			if isDirection(value) then
				context.touched = true
				local delta = context.aim.position - context.origin

				if delta.Magnitude > 0.1 then
					replacement = delta.Unit
				end
			elseif (value - context.rootPosition).Magnitude > ORIGIN_RADIUS then
				context.touched = true
				replacement = context.aim.position
			else
				replacement = value + context.shift
			end

			if replacement ~= value then
				context.changed = true
			end

			return replacement
		end

		if valueType == "CFrame" then
			context.touched = true
			local replacement = value

			if (value.Position - context.rootPosition).Magnitude <= ORIGIN_RADIUS then
				local position = value.Position + context.shift

				if (context.aim.position - position).Magnitude > 0.1 then
					replacement = CFrame.lookAt(position, context.aim.position)
				end
			else
				replacement = CFrame.new(context.aim.position)
			end

			if replacement ~= value then
				context.changed = true
			end

			return replacement
		end

		if valueType == "Ray" then
			local origin = value.Origin + context.shift
			local newDirection = aimDirection(context, origin, value.Direction.Magnitude)

			if newDirection then
				context.touched = true
				context.changed = true
				return Ray.new(origin, newDirection)
			end

			return value
		end

		if valueType == "table" and depth < MAX_TABLE_DEPTH then
			local copy = table.clone(value)

			for key, inner in pairs(copy) do
				copy[key] = rewriteValue(inner, context, depth + 1)
			end

			return copy
		end

		return value
	end

	---Rewrite every argument of a remote call.
	---@param args table
	---@param context table
	---@return table
	local function rewriteArgs(args, context)
		for index = 1, args.n do
			local value = args[index]

			if typeof(value) == "Vector3" and value.Magnitude >= 0.01 and not isDirection(value) and (value - context.rootPosition).Magnitude <= ORIGIN_RADIUS then
				context.origin = value + context.shift
				break
			end
		end

		local rewritten = table.clone(args)

		for index = 1, args.n do
			rewritten[index] = rewriteValue(args[index], context, 0)
		end

		return rewritten
	end

	---Refresh the status label.
	local function updateStatus()
		if not statusLabel or not statusLabel.Parent then
			return
		end

		local toolText = config.toolName ~= "" and config.toolName or "*"

		statusLabel.Text = state.templateCount > 0
			and string.format("Learned %d remote(s) [%s]", state.templateCount, toolText)
			or string.format("Shoot once to learn [%s]", toolText)
	end

	---Remember a gun call that carries target data so it can be replayed.
	---@param remote Instance
	---@param method string
	---@param args table
	---@param context table
	local function storeTemplate(remote, method, args, context)
		local known = state.templates[remote] ~= nil

		if not known then
			if state.templateCount >= MAX_TEMPLATES then
				return
			end

			state.templateCount += 1
		end

		state.templates[remote] = {
			method = method,
			args = args,
			rootPosition = context.rootPosition,
		}

		if not known then
			task.defer(updateStatus)
		end
	end

	---Work out how to rewrite a watched call. Returns nothing to pass the call through.
	---@param self Instance
	---@param method string
	---@return string?, any, any, any
	local function computeRewrite(self, method, ...)
		local isRemoteCall = method == "FireServer" or method == "InvokeServer"

		if isRemoteCall then
			if typeof(self) ~= "Instance" or not (S.silentAim or S.autoDamage) then
				return nil
			end
		elseif self ~= workspace or not S.silentAim then
			return nil
		end

		local context = resolveContext(isRemoteCall and self or nil)

		if not context then
			return nil
		end

		if method == "Raycast" then
			local origin, direction, params = ...

			if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
				return nil
			end

			local newDirection = aimDirection(context, origin, direction.Magnitude)

			if not newDirection then
				return nil
			end

			return "raycast", origin, newDirection, config.ignoreWalls and includeParams(context.aim.part) or params
		end

		if isRemoteCall then
			local args = table.pack(...)
			local rewritten = rewriteArgs(args, context)

			if context.touched then
				storeTemplate(self, method, args, context)
			end

			if config.debug then
				debugPrint(string.format("%s:%s %s", self:GetFullName(), method, context.touched and "(target data)" or "(no target data found)"), {
					before = { table.unpack(args, 1, args.n) },
					after = { table.unpack(rewritten, 1, rewritten.n) },
				})
			end

			if not context.changed or not S.silentAim then
				return nil
			end

			return "args", rewritten
		end

		local ray = ...

		if typeof(ray) ~= "Ray" then
			return nil
		end

		local newDirection = aimDirection(context, ray.Origin, ray.Direction.Magnitude)

		if not newDirection then
			return nil
		end

		local newRay = Ray.new(ray.Origin, newDirection)

		if config.ignoreWalls then
			return "whitelist", newRay, { context.aim.part }
		end

		local args = table.pack(...)
		args[1] = newRay

		return "args", args
	end

	---Handle a watched namecall. Errors in the rewrite never break the game's call.
	---@param oldNamecall function
	---@param self Instance
	---@param method string
	local function onNamecall(oldNamecall, self, method, ...)
		local success, mode, first, second, third = pcall(computeRewrite, self, method, ...)

		if not success and config.debug then
			warn(mode)
		end

		if success and mode == "raycast" then
			return workspace.Raycast(workspace, first, second, third)
		end

		if success and mode == "whitelist" then
			return workspace.FindPartOnRayWithWhitelist(workspace, first, second)
		end

		if success and mode == "args" then
			setNamecallMethod(method)
			return oldNamecall(self, table.unpack(first, 1, first.n))
		end

		setNamecallMethod(method)
		return oldNamecall(self, ...)
	end

	---Install the shared namecall hook once, then point it at our handler.
	local function ensureHook()
		if not hookState.installed then
			local oldNamecall

			local hook = newcclosure(function(self, ...)
				local method = getnamecallmethod()
				local handler = hookState.handler

				if handler and WATCHED_METHODS[method] and not checkcaller() then
					return handler(oldNamecall, self, method, ...)
				end

				return oldNamecall(self, ...)
			end)

			pcall(setstackhidden, hook, true)
			oldNamecall = hookmetamethod(game, "__namecall", hook)
			hookState.installed = true
		end

		hookState.handler = onNamecall
	end

	---Send one learned call. Direct calls skip the namecall path and never touch the gun.
	---@param remote Instance
	---@param method string
	---@param args table
	local function sendTemplate(remote, method, args)
		local callback = method == "InvokeServer" and remote.InvokeServer or remote.FireServer
		pcall(callback, remote, table.unpack(args, 1, args.n))
	end

	---Replay the learned gun calls against the target without firing the gun.
	local function replayDamage()
		local tool = getEquippedTool()

		if not tool then
			return
		end

		local context = buildContext(tool)

		if not context then
			return
		end

		for remote, template in pairs(state.templates) do
			if not remote.Parent then
				state.templates[remote] = nil
				state.templateCount -= 1
				task.defer(updateStatus)
				continue
			end

			context.rootPosition = template.rootPosition
			context.shift = context.currentRoot - template.rootPosition
			context.origin = context.currentOrigin

			local rewritten = rewriteArgs(template.args, context)

			if config.debug then
				debugPrint("replay " .. remote:GetFullName(), { table.unpack(rewritten, 1, rewritten.n) })
			end

			for _ = 1, config.damageBurst do
				task.spawn(sendTemplate, remote, template.method, rewritten)
			end
		end
	end

	---Replay the damage on a timer while the gun is held.
	local function onHeartbeat()
		if not S.autoDamage or state.templateCount == 0 then
			return
		end

		local now = os.clock()

		if now < state.nextDamage then
			return
		end

		state.nextDamage = now + config.damageInterval

		local success, errorMessage = pcall(replayDamage)

		if not success and config.debug then
			warn(errorMessage)
		end
	end

	-- Interface.
	setSilent = toggle(pSilent, "Silent Aim  (RightCtrl)", function(v)
		S.silentAim = v

		if v then
			ensureHook()
		end
	end)

	setDamage = toggle(pSilent, "Auto Damage  (RightAlt)", function(v)
		S.autoDamage = v

		if v then
			ensureHook()
		end
	end)

	statusLabel = liveInfo(pSilent, "")
	updateStatus()

	heading(pSilent, "Targeting")

	inputButton(pSilent, "Tool name (empty = any)", config.toolName, "SET", function(text)
		config.toolName = (text:gsub("^%s+", ""):gsub("%s+$", ""))
		updateStatus()
		notify("Tool: " .. (config.toolName ~= "" and config.toolName or "any"))
	end)

	inputButton(pSilent, "Target name (empty = auto)", config.targetName, "SET", function(text)
		config.targetName = (text:gsub("^%s+", ""):gsub("%s+$", ""))
		state.target = nil
		state.lastSearch = 0
		notify("Target: " .. (config.targetName ~= "" and config.targetName or "auto"))
	end)

	slider(pSilent, "Hit Chance %", 1, 100, config.hitChance, function(v) config.hitChance = v end)
	slider(pSilent, "Max Distance", 20, 2000, config.maxDistance, function(v) config.maxDistance = v end)

	local setStrict = toggle(pSilent, "Strict Caller (gun scripts only)", function(v) config.strictCaller = v end)
	setStrict(true)
	toggle(pSilent, "Ignore Walls", function(v) config.ignoreWalls = v end)

	heading(pSilent, "Auto Damage")
	slider(pSilent, "Damage Interval (ms)", 10, 500, config.damageInterval * 1000, function(v) config.damageInterval = v / 1000 end)
	slider(pSilent, "Damage Burst", 1, 10, config.damageBurst, function(v) config.damageBurst = v end)

	button(pSilent, "Clear Learned Remotes", function()
		table.clear(state.templates)
		state.templateCount = 0
		updateStatus()
		notify("Cleared")
	end)

	heading(pSilent, "Debug")
	toggle(pSilent, "Debug Log (Data2Code)", function(v)
		config.debug = v

		if v and not serializer then
			task.spawn(function()
				serializer = loadSerializer()
			end)
		end
	end)

	track(UIS.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or UIS:GetFocusedTextBox() then
			return
		end

		if input.KeyCode == SILENT_KEY then
			setSilent(not S.silentAim)
		elseif input.KeyCode == DAMAGE_KEY then
			setDamage(not S.autoDamage)
		end
	end))

	track(RunService.Heartbeat:Connect(onHeartbeat))

	-- The hook stays installed but passes everything through once detached.
	onCleanup(function()
		hookState.handler = nil
		table.clear(state.templates)
	end)
end)

