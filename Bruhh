	end

	return current
end

local function readValue(folder, name)
	local child = folder:FindFirstChild(name)

	if child and child:IsA("ValueBase") then
		return child.Value
	end

	return folder:GetAttribute(name)
end

local function isActive(folder)
	for _, name in ipairs(CONFIG.flags) do
		local value = readValue(folder, name)

		if value == true or (type(value) == "number" and value > 0) then
