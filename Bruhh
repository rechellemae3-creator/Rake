---Remember a connection so it can be cleaned up.
---@param connection RBXScriptConnection
---@return RBXScriptConnection
local function track(connection)
	table.insert(connections, connection)
	return connection
end

---Run a callback in a loop while its flag stays on.
---@param key string
---@param getDelay function
---@param callback function
local function startLoop(key, getDelay, callback)
	loopIds[key] = (loopIds[key] or 0) + 1
	local id = loopIds[key]

	task.spawn(function()
		while alive and flags[key] and loopIds[key] == id do
			pcall(callback)
			task.wait(getDelay())
		end
	end)
end

-- Interface helpers.

---Round the corners of a gui object.
---@param instance GuiObject
---@param radius number
local function corner(instance, radius)
	Instance.new("UICorner", instance).CornerRadius = UDim.new(0, radius)
end

---Get the next layout order for a page.
---@param page Instance
---@return number
local function nextOrder(page)
	orders[page] = (orders[page] or 0) + 1
	return orders[page]
end

---Create a plain text label.
---@param parent Instance
---@param text string
---@param size number
---@param color Color3
---@param font Enum.Font
---@return TextLabel
local function createLabel(parent, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.Font = font
	label.TextSize = size
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.Parent = parent
	return label
end

---Create a clickable row on a page.
---@param page Instance
---@param height number
---@return TextButton
local function createRow(page, height)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, height)
	row.BackgroundColor3 = COLOR_ROW
	row.BorderSizePixel = 0
	row.AutoButtonColor = false
	row.Text = ""
	row.LayoutOrder = nextOrder(page)
	row.Parent = page
	corner(row, 6)

	track(row.MouseEnter:Connect(function()
		row.BackgroundColor3 = COLOR_ROW_HOVER
	end))

	track(row.MouseLeave:Connect(function()
		row.BackgroundColor3 = COLOR_ROW
	end))

	return row
end

