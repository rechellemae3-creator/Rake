	local function readPityValue(folder, name)
		local child = folder:FindFirstChild(name)

		if child and child:IsA("ValueBase") then
			return child.Value
		end

		return folder:GetAttribute(name)
	end

	---Check whether a value counts as on.
	---@param value any
	---@return boolean
