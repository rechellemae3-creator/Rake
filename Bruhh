	onCleanup(clearItems)

	toggle(pRake, "Rakoof HP Tag", function(v)
		S.rkTag = v
		if not v then clearTag() end
	end)

	local function scanItems()
		local seen, count = {}, 0
		for _, folderName in ipairs({"Drops", "TempItems", "Spawneables"}) do
			local f = WS:FindFirstChild(folderName)
			if f then
				for _, o in ipairs(f:GetChildren()) do
					if count >= 80 then break end
					if o:IsA("Model") or o:IsA("BasePart") or o:IsA("Tool") then
						seen[o] = true
						count = count + 1
						if not itemHL[o] then
							itemHL[o] = new("Highlight", {
								Name = tostring(math.random(100000, 999999)),
								FillColor = Color3.fromRGB(255, 220, 60),
								OutlineColor = Color3.new(1, 1, 1),
								FillTransparency = 0.5,
							}, o)
						end
					end
				end
			end
		end
		for o, hl in pairs(itemHL) do
			if not seen[o] or not o.Parent then
				pcall(function() hl:Destroy() end)
				itemHL[o] = nil
			end
		end
	end

	toggle(pRake, "Item ESP (Drops / TempItems / Spawneables)", function(v)
