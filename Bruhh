	---Find the PityChaos folder in this server.
	---@return Instance?
	local function findPityFolder()
		local current = WS

		for _, name in ipairs(PITY_PATH) do
			current = current:FindFirstChild(name)

			if not current then
				return nil
			end
		end

		return current
