	---Update every status line.
	---@param text string
	---@param color Color3?
	local function setStatus(text, color)
		for _, label in ipairs(statusLabels) do
			if label.Parent then
				label.Text = text
				label.TextColor3 = color or C.dim
			end
		end
	end

	---Request one page of servers, retrying when rate limited.
	---@param order string
	---@param cursor string?
	---@return table?
	local function fetchPage(order, cursor)
		local url = string.format(API_URL, game.PlaceId, order)

		if cursor then
			url = url .. "&cursor=" .. httpService:UrlEncode(cursor)
		end

		for attempt = 1, RETRY_LIMIT do
			local success, response = pcall(httpRequest, { Url = url, Method = "GET" })

			if success and response and response.StatusCode == 200 then
				local decoded, body = pcall(httpService.JSONDecode, httpService, response.Body)
				return decoded and body or nil
			end

			-- Back off before trying again.
			task.wait(attempt * 1.5)
		end
	end

	---Collect servers from both sort orders so the real extremes are included.
	---@return table
	local function fetchServers()
		local found = {}
		local list = {}

		for _, order in ipairs(SORT_ORDERS) do
			local cursor = nil

			for _ = 1, MAX_PAGES do
				local page = fetchPage(order, cursor)

				if not page or not page.data then
					break
				end

				for _, server in ipairs(page.data) do
					if not found[server.id] then
						found[server.id] = true
						table.insert(list, server)
					end
				end

				cursor = page.nextPageCursor

				if not cursor then
					break
				end

				task.wait(PAGE_DELAY)
			end

			task.wait(PAGE_DELAY)
		end

		return list
	end

	---Sort the servers by player count.
	local function sortServers()
		table.sort(state.servers, function(a, b)
			if a.playing ~= b.playing then
				if state.mostFirst then
					return a.playing > b.playing
				end

				return a.playing < b.playing
			end

			return a.id < b.id
		end)
	end

	---Check whether a server can be joined from here.
	---@param server table
	---@return boolean
	local function isJoinable(server)
		return server.id ~= game.JobId and server.playing < server.maxPlayers
	end

	---Pick the most or least populated server that can be joined.
	---@param most boolean
	---@return table?, number?
	local function pickServer(most)
		local best = nil
		local bestIndex = nil

		for index, server in ipairs(state.servers) do
			if not isJoinable(server) then
				continue
			end

			if not best or (most and server.playing > best.playing) or (not most and server.playing < best.playing) then
				best = server
				bestIndex = index
			end
		end

		return best, bestIndex
	end

	---Teleport to a server.
	---@param server table
	---@param label string
	local function joinServer(server, label)
		if server.id == game.JobId then
			return setStatus("You are already in this server.", WARN)
		end

		if server.playing >= server.maxPlayers then
			return setStatus(label .. " is full.", WARN)
		end

		setStatus("Teleporting to " .. label .. "...", GOOD)

		local success, errorMessage = pcall(teleportService.TeleportToPlaceInstance, teleportService, game.PlaceId, server.id, LP)

		if not success then
			setStatus("Teleport failed: " .. tostring(errorMessage), C.red)
		end
