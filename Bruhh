			if p then tpTo(p, 5) else notify(n .. " not found") end
		end)
	end

	local NPCS = {
		{"Trader Mark", {"Trader", "Mark"}},
		{"Trader Wood Craftes", {"Trader", "Wood Craftes"}},
		{"Trader Lady", {"Trader", "Lady"}},
		{"Shop Vendor", {"Shop", "VendedorA"}},
	}
	for _, npc in ipairs(NPCS) do
		button(pRake, "TP: " .. npc[1], function()
			local cur = WS
			for _, n in ipairs(npc[2]) do cur = cur and cur:FindFirstChild(n) end
			if cur then tpTo(cur, 4) else notify(npc[1] .. " not found") end
		end)
	end

	-- ---------- LIVE LOOP ----------
	local samples = {}
	local peakDps = 0

	task.spawn(function()
		while alive do
			task.wait(0.25)
			pcall(function()
				local now = os.clock()
				local boss = getBoss()
				local root = getRoot()
				local hp, max = bossHealth()

				-- damage per second over the last 3 seconds
				local dps = 0
				if hp then
					samples[#samples + 1] = {t = now, hp = hp}
					while #samples > 0 and now - samples[1].t > 3 do table.remove(samples, 1) end
					local first, last = samples[1], samples[#samples]
					if first and last and last.t - first.t >= 0.5 and first.hp > last.hp then
						dps = (first.hp - last.hp) / (last.t - first.t)
					end
					if dps > peakDps then peakDps = dps end
				end

				local dist = root and bossDistance(root.Position) or math.huge
				local distText = dist < math.huge and (fmt(dist) .. " studs") or "n/a"
				if hp then
					local pct = (max and max > 0) and math.floor(hp / max * 100 + 0.5) or 0
					local state = ""
					if boss then
						if readValue(boss, "Stunning") == true then state = "  [STUNNED]"
						elseif readValue(boss, "StunBlock") == true then state = "  [stun-immune]" end
					end
					hpLine.Text = "Rakoof HP: " .. fmt(hp) .. " / " .. fmt(max or 0) .. " (" .. pct .. "%)  -  " .. distText .. state
				else
					hpLine.Text = "Rakoof HP: not found (is the Rake spawned?)"
				end

				local need = readValue(WS:FindFirstChild("RewardUIValues"), "MinDPS")
				dpsLine.Text = "DPS (3s): " .. fmt(dps) .. "   peak: " .. fmt(peakDps)
					.. (type(need) == "number" and need > 0 and ("   reward needs: " .. fmt(need)) or "")

				local values = WS:FindFirstChild("RewardUIValues")
				local modeName = readValue(values, "ModeName")
				local modeOn = readValue(values, "Mode")
				local powerOut = readValue(WS, "PowerOutValue")
				local usage = readValue(WS, "PowerUsageValue")
				modeLine.Text = "Mode: " .. ((type(modeName) == "string" and modeName ~= "") and modeName or "none")
					.. (modeOn == true and " (active)" or "")
					.. "   Power: " .. (powerOut == true and "OUT" or "on")
					.. (type(usage) == "number" and ("  usage " .. fmt(usage)) or "")

				local tool = equippedTool()
				if tool then
					watchTool(tool)
					local st = cdState[tool]
					weaponLine.Text = "Weapon: " .. tool.Name
						.. "  dmg " .. short(toolNumber(tool, "Damage", "?"))
						.. "  cd " .. short(toolNumber(tool, "Cooldown", "?"))
						.. "  hitCD " .. short(toolNumber(tool, "HitCD", "?"))
						.. ((st and st.text ~= "") and ("  server: " .. st.text) or "")
				else
					weaponLine.Text = "Weapon: nothing equipped"
				end

				-- Rake HP tag
				if S.rkTag and boss then
					local part = hitboxOf(boss)
					if part and (not tag or tag.Parent ~= part) then
						clearTag()
						tag = new("BillboardGui", {
							Name = tostring(math.random(100000, 999999)),
							Size = UDim2.new(0, 180, 0, 34),
							StudsOffset = Vector3.new(0, 7, 0),
							AlwaysOnTop = true,
						}, part)
						new("TextLabel", {
							Name = "t",
							Size = UDim2.new(1, 0, 1, 0),
							BackgroundTransparency = 1,
							TextColor3 = Color3.fromRGB(255, 90, 110),
							TextStrokeTransparency = 0.3,
							Font = Enum.Font.GothamBold,
							TextSize = 16,
						}, tag)
					end
					local label = tag and tag:FindFirstChild("t")
					if label and hp then
						label.Text = "RAKOOF " .. ((max and max > 0) and (math.floor(hp / max * 100 + 0.5) .. "%") or fmt(hp))
					end
				elseif tag then
					clearTag()
				end
			end)
		end
	end)
end)

-- ============ FARM TAB ============
guard("farm", function()
	-- ---- DROPS ----
	-- add more drops here. "id" is the debug id from your snippet; debug ids change
	-- between sessions, so if the exact id isn't found it falls back to the first
	-- nil instance with that name.
	local DROPS = {
		{name = "Coin",       id = "1_200886"},
		{name = "TrainerCap", id = "1_239393"},
	}
	local dropChance = 25

	local function getNil(name, debugId)
		if not getnilinstances then return nil end
		for _, o in ipairs(getnilinstances()) do
			if o.Name == name then
				if not debugId or o:GetDebugId() == debugId then
					return o
				end
			end
		end
	end

	local nilCache = {}
	local function resolveDrop(d)
		if nilCache[d.name] then return nilCache[d.name] end
		local inst = getNil(d.name, d.id) or getNil(d.name)
		nilCache[d.name] = inst
		return inst
	end

	local function posOf(o)
		if typeof(o) ~= "Instance" then return nil end
		local ok, p = pcall(function()
			if o:IsA("BasePart") then return o.Position end
			if o:IsA("Model") then return o:GetPivot().Position end
			if o:IsA("Tool") then
				local h = o:FindFirstChild("Handle")
				return h and h.Position
			end
		end)
		return ok and p or nil
	end

	local function tpTo(p, fromDrop)
		local root = getRoot()
		if root and p then
			root.CFrame = CFrame.new(p + Vector3.new(0, 3, 0))
			if fromDrop then aiPauseUntil = tick() + 1.5 end
		end
	end

	local function spawnDrop(d)
		local ev = RS:FindFirstChild("SpawnDrop")
		if not ev then notify("SpawnDrop remote not found") return false end
		if not firesignal then notify("Your executor has no firesignal") return false end
		local inst = resolveDrop(d)
		if not inst then
			notify("Couldn't find '" .. d.name .. "' (needs getnilinstances)")
			return false
		end
		firesignal(ev.OnClientEvent, inst)
		return true
	end

	local function rollDrop(fallbackPos)
		local d = DROPS[math.random(#DROPS)]
		local found
		local c = WS.DescendantAdded:Connect(function(o)
			if o.Name == d.name then found = o end
		end)
		local ok = spawnDrop(d)
		task.wait(0.3)
		c:Disconnect()
		if ok and S.tpDrop then
			tpTo(posOf(found) or fallbackPos, true)
		end
	end

	local dropConn = nil
	local function bindDropListener()
		if dropConn then return true end
		local ev = RS:FindFirstChild("SpawnDrop")
		if not ev then return false end
		dropConn = ev.OnClientEvent:Connect(function(obj)
			if not S.tpDrop then return end
			if typeof(obj) ~= "Instance" or not obj:IsDescendantOf(WS) then return end
			task.wait(0.1)
			tpTo(posOf(obj), true)
		end)
		track(dropConn)
		return true
	end

	local hooked = setmetatable({}, {__mode = "k"})
	local function hookEnemy(m, hum)
		if hooked[m] then return end
		hooked[m] = true
		if hum.Health <= 0 then return end
		track(hum.Died:Connect(function()
			if not S.drops then return end
			if math.random() * 100 > dropChance then return end
			local ok, pos = pcall(function() return m:GetPivot().Position end)
			task.spawn(rollDrop, ok and pos or nil)
		end))
	end

	task.spawn(function()
		while alive do
			task.wait(1)
			if S.drops then
				for _, m in ipairs(WS:GetChildren()) do
					if m:IsA("Model") and m ~= LP.Character
					and Players:GetPlayerFromCharacter(m) == nil then
						local mh = m:FindFirstChildOfClass("Humanoid")
						if mh then hookEnemy(m, mh) end
					end
				end
			end
		end
	end)

	heading(pFarm, "Drops")
	toggle(pFarm, "Enemy Drops", function(v) S.drops = v end)
	slider(pFarm, "Drop Chance %", 0, 100, dropChance, function(v) dropChance = v end)
	toggle(pFarm, "Teleport to Drops", function(v)
		S.tpDrop = v
		if v and not bindDropListener() then
			notify("SpawnDrop not found - only enemy drops teleport")
		end
	end)
	button(pFarm, "Spawn Random Drop Now", function()
		local root = getRoot()
		task.spawn(rollDrop, root and root.Position or nil)
	end)

	-- ---- AUTO PICKUP ----
	heading(pFarm, "Pickup")
	local pickupMs, pickupRadius = 100, 200
	toggle(pFarm, "Auto Pickup", function(v)
		S.pickup = v
		if not v then return end
		runLoop("pickup", function() return pickupMs / 1000 end, function()
			local root = getRoot()
			if not root then return end
			for _, o in ipairs(WS:GetDescendants()) do
				if not S.pickup then break end
				local part
				if o:IsA("Tool") then
					part = o:FindFirstChild("Handle")
				elseif o:IsA("BasePart") then
					local n = o.Name:lower()
					if n:find("drop") or n:find("coin") or n:find("item") or n:find("candy") then
						part = o
					end
				elseif o:IsA("ProximityPrompt") then
					local pp = o.Parent
					if pp and pp:IsA("BasePart") and not isRiskyPrompt(o)
					and (pp.Position - root.Position).Magnitude < pickupRadius then
						pcall(fireproximityprompt, o)
					end
				end
				if part and part:IsA("BasePart")
				and (part.Position - root.Position).Magnitude < pickupRadius then
					touch(root, part)
				end
			end
		end)
	end)
	slider(pFarm, "Pickup Speed (ms)", 20, 1000, pickupMs, function(v) pickupMs = v end)
	slider(pFarm, "Pickup Radius", 20, 500, pickupRadius, function(v) pickupRadius = v end)

	-- ---- CANDY ----
	heading(pFarm, "Candy")
	local function isCandy(o)
		local n = o.Name:lower()
		return n:find("candycorn") or n:find("candybucket") or n:find("candypack")
	end
	local function candyPart(o)
		return o:IsA("BasePart") and o
			or o:FindFirstChild("Handle")
			or o:FindFirstChildWhichIsA("BasePart")
	end

	toggle(pFarm, "Auto Candy (teleport to it)", function(v)
		S.candy = v
		if not v then return end
		runLoop("candy", function() return 0.5 end, function()
			local root = getRoot()
			if not root then return end
			for _, o in ipairs(WS:GetDescendants()) do
				if not S.candy then break end
				if isCandy(o) then
					local part = candyPart(o)
					if part then
						aiPauseUntil = tick() + 0.6
						root.CFrame = part.CFrame + Vector3.new(0, 2, 0)
						touch(root, part)
						task.wait(0.3)
					end
				end
			end
		end)
	end)

	local bringRange = 150
	toggle(pFarm, "Bring Candy to Me", function(v)
		S.bringCandy = v
		if not v then return end
		runLoop("bringCandy", function() return 0.4 end, function()
			local root = getRoot()
			if not root then return end
			local spot = root.CFrame * CFrame.new(0, 0, -3)
			for _, o in ipairs(WS:GetDescendants()) do
				if not S.bringCandy then break end
				if isCandy(o) then
					local part = candyPart(o)
					if part and (part.Position - root.Position).Magnitude <= bringRange then
						pcall(function()
							if o:IsA("Model") then
								o:PivotTo(spot)
							else
								part.CFrame = spot
								part.AssemblyLinearVelocity = Vector3.zero
							end
						end)
						touch(root, part)
					end
				end
			end
		end)
	end)
	slider(pFarm, "Bring Range", 20, 500, bringRange, function(v) bringRange = v end)

	-- ---- SOULS / SPAWNABLES / PROMPTS ----
	heading(pFarm, "Misc Farm")
	toggle(pFarm, "Bring Souls to Me", function(v)
		S.souls = v
		if not v then return end
		runLoop("souls", function() return 0.2 end, function()
			local root = getRoot()
			local misc = WS:FindFirstChild("Misc") or WS:FindFirstChild("misc")
			if not root or not misc then return end
			for _, o in ipairs(misc:GetDescendants()) do
				if not S.souls then break end
				if o.Name:lower():find("soul") then
					pcall(function()
						if o:IsA("BasePart") then
							o.CFrame = root.CFrame
						elseif o:IsA("Model") then
							o:PivotTo(root.CFrame)
						end
					end)
				end
			end
		end)
	end)

	toggle(pFarm, "Spawnables -> Rakoof", function(v)
		S.spawnables = v
		if not v then return end
		runLoop("spawnables", function() return 0.1 end, function()
			local rk = getRakoof()
			local rp = rk and partOf(rk)
			local folder = WS:FindFirstChild("Spawneables") or WS:FindFirstChild("Spawnables") or WS:FindFirstChild("spawnables")
			if not rp or not folder then return end
			for _, o in ipairs(folder:GetDescendants()) do
				if o:IsA("Model") then
					pcall(function() o:PivotTo(rp.CFrame) end)
				elseif o:IsA("BasePart") and o.Parent == folder then
					o.CFrame = rp.CFrame
				end
			end
		end)
	end)

	toggle(pFarm, "Auto Interact (all prompts)", function(v)
		S.prompts = v
		if not v then return end
		runLoop("prompts", function() return 0.3 end, function()
			for _, o in ipairs(WS:GetDescendants()) do
				if not S.prompts then break end
				if o:IsA("ProximityPrompt") and not isRiskyPrompt(o) then pcall(fireproximityprompt, o) end
			end
		end)
	end)
end)

