-- Game helpers.

---Get the local character's root part.
---@return BasePart?
local function getRoot()
	local character = localPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

---Get the local humanoid.
---@return Humanoid?
local function getHumanoid()
	local character = localPlayer.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

---Move the character to a position.
---@param cframe CFrame
local function teleportTo(cframe)
	local root = getRoot()

	if not root then
		return
	end

	root.CFrame = cframe
	root.AssemblyLinearVelocity = Vector3.zero
end

---Resolve a path of child names under workspace to a position.
---@param path table
---@return CFrame?
local function resolvePath(path)
	local current = workspace

	for _, name in ipairs(path) do
		current = current:FindFirstChild(name)

		if not current then
			return nil
		end
	end

	if current:IsA("PVInstance") then
		local success, pivot = pcall(current.GetPivot, current)
		return success and pivot or nil
	end

	local part = current:FindFirstChildWhichIsA("BasePart", true)
	return part and part.CFrame or nil
end

---Update the steal status label.
---@param text string
local function setStatus(text)
	if interface.status and interface.status.Parent then
		interface.status.Text = text
	end
end

---Refresh the stolen counter.
local function refreshCounter()
	if interface.counter and interface.counter.Parent then
		interface.counter.Text = "Stolen this session: " .. stolenCount
	end
end

---Send the character back to the safe zone sign.
local function returnToSafe()
	local safe = resolvePath(SAFE_PATH)

	if not safe then
		return setStatus("Safe zone sign not found.")
	end

	teleportTo(safe + SAFE_OFFSET)
end

---Run an action near a part, teleporting there and back only when we are too far.
---@param part BasePart
---@param range number
---@param action function
local function performNear(part, range, action)
	local root = getRoot()

	if not root or not part or not part.Parent then
		return
	end

	if (root.Position - part.Position).Magnitude <= range + NEAR_MARGIN then
		return action()
	end

	local origin = root.CFrame

	teleportTo(part.CFrame + TARGET_OFFSET)
	task.wait(ARRIVE_DELAY)
	pcall(action)
	teleportTo(origin)
end

---Find the plot the local player owns.
---@return Instance?
local function getMyPlot()
	local map = workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")

	if not plots then
		return nil
	end

	for _, plot in ipairs(plots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == localPlayer.UserId then
			return plot
		end
	end
end

-- Steal logic.

---Read a table's rarity from its label, falling back to its name.
---@param model Instance
---@return string
local function getRarity(model)
	local label = model:FindFirstChild("Rarity", true)

	if label and label:IsA("TextLabel") then
		local text = string.match(label.Text, "%a+")

		if text then
			return text
		end
	end

	for rarity in pairs(RARITY_RANK) do
		if string.find(model.Name, rarity, 1, true) then
			return rarity
		end
	end

	return "Unknown"
end

---Find the steal prompt on a table.
---@param model Instance
---@return ProximityPrompt?
local function getPrompt(model)
	local prompt = model:FindFirstChild(PROMPT_NAME, true)

	if prompt and prompt:IsA("ProximityPrompt") then
		return prompt
	end

	return model:FindFirstChildWhichIsA("ProximityPrompt", true)
end

---List every table that can be stolen right now, best first.
---@return table
local function collectCandidates()
	local folder = workspace:FindFirstChild(FOLDER_NAME)
	local root = getRoot()
	local list = {}

	if not folder then
		return list
	end

	local boost = string.lower(settings.boostText)

	for _, model in ipairs(folder:GetChildren()) do
		local prompt = model:IsA("Model") and getPrompt(model)

		if prompt and prompt.Enabled then
			local rarity = getRarity(model)
			local last = attempted[model]

			-- Unknown rarities are always allowed, listed ones follow the filter.
			if enabledRarities[rarity] ~= false and (not last or os.clock() - last > RETRY_DELAY) then
				local rank = (RARITY_RANK[rarity] or 0)

				if PRIORITY_NAMES[model.Name] or (boost ~= "" and string.find(string.lower(model.Name), boost, 1, true)) then
					rank += PRIORITY_BONUS
				end

				local distance = root and (prompt.Parent.Position - root.Position).Magnitude or 0
				table.insert(list, { model = model, prompt = prompt, rarity = rarity, rank = rank, distance = distance })
			end
		end
	end

	table.sort(list, function(a, b)
		if settings.sortByRarity and a.rank ~= b.rank then
			return a.rank > b.rank
		end

		return a.distance < b.distance
	end)

	return list
end

---Teleport to one table, trigger it, then go back.
---@param candidate table
---@return boolean
local function stealFrom(candidate)
	local model = candidate.model
	local prompt = candidate.prompt
	local success, pivot = pcall(model.GetPivot, model)

	if not success then
		return false
	end

	local origin = getRoot() and getRoot().CFrame

	attempted[model] = os.clock()
	setStatus("Stealing " .. model.Name .. " (" .. candidate.rarity .. ")")

	-- Make sure the prompt fires from anywhere on the table.
	pcall(function()
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 30)
	end)

	teleportTo(pivot + TARGET_OFFSET)
	task.wait(ARRIVE_DELAY)

	local stolen = false
	local deadline = os.clock() + settings.timeout

	while os.clock() < deadline and model.Parent do
		local character = localPlayer.Character

		if not prompt.Parent or not prompt.Enabled or (character and model:IsDescendantOf(character)) then
			stolen = true
			break
		end

		pcall(fireproximityprompt, prompt)
		task.wait(FIRE_INTERVAL)
	end

	if not model.Parent then
		stolen = true
	end

	-- Leave whether the steal worked or not.
	if settings.returnToSafe then
		returnToSafe()
	elseif origin then
		teleportTo(origin)
	end

	if stolen then
		stolenCount += 1
		setStatus("Stole " .. model.Name)
	else
		setStatus("Missed " .. model.Name .. ", moving on")
	end

	refreshCounter()
	return stolen
end

---Steal the best available table once.
local function stealOnce()
	if busy then
		return
	end

	busy = true

	local candidates = collectCandidates()

	if #candidates == 0 then
		setStatus("No stealable tables right now.")
	else
		pcall(stealFrom, candidates[1])
	end

	busy = false
end

---Start or stop the auto steal.
---@param state boolean
local function setAutoSteal(state)
	flags.steal = state

	if state then
		table.clear(attempted)
		setStatus("Auto steal started.")
		startLoop("steal", function() return settings.cycleDelay end, function()
			if getRoot() then
				stealOnce()
			end
		end)
	else
		setStatus("Auto steal stopped.")
	end
end

-- Farm logic.

---Open every ready box on our own plot.
local function openReadyBoxes()
	local plot = getMyPlot()
	local placed = plot and plot:FindFirstChild("PlacedBaunan")

	if not placed then
		return
	end

	for _, descendant in ipairs(placed:GetDescendants()) do
		if not flags.openBoxes then
			return
		end

		if descendant:IsA("ProximityPrompt") and descendant.Name == "UnboxPrompt" and descendant.Enabled and string.upper(descendant.ActionText) == "OPEN" then
			performNear(descendant.Parent, descendant.MaxActivationDistance, function()
				fireproximityprompt(descendant)
			end)

			task.wait(0.2)
		end
	end
end

---Find our own treadmill upgrade sign.
---@return Instance?
local function getMySign()
	local folder = workspace:FindFirstChild("Treadmills")

	if not folder then
		return nil
	end

	for _, child in ipairs(folder:GetChildren()) do
		if child.Name == "UpgradeSign" and child:GetAttribute("OwnerUserId") == localPlayer.UserId then
			return child
		end
	end
end

---Click our treadmill upgrade button once.
---@return boolean
local function upgradeTreadmill()
	local sign = getMySign()
	local detector = sign and sign:FindFirstChild("UpgradeClick", true)

	if not detector or not fireclickdetector then
		return false
	end

	performNear(detector.Parent, detector.MaxActivationDistance, function()
		fireclickdetector(detector)
	end)

	return true
end

---Claim the free gift pad.
local function claimGift()
	local zone = workspace:FindFirstChild("FreeGift") and workspace.FreeGift:FindFirstChild("TouchZone")
	local root = getRoot()

	if not zone or not root then
		return
	end

	if firetouchinterest then
		firetouchinterest(root, zone, 0)
		firetouchinterest(root, zone, 1)
	else
		performNear(zone, 0, function()
			task.wait(0.4)
		end)
	end
end

-- Visuals logic.

---Remove every ESP object.
local function clearEsp()
	for model, objects in pairs(espObjects) do
		for _, object in ipairs(objects) do
			pcall(object.Destroy, object)
		end

		espObjects[model] = nil
	end
end

---Create or refresh the table ESP.
local function updateEsp()
	local folder = workspace:FindFirstChild(FOLDER_NAME)

	if not folder then
		return clearEsp()
	end

	local seen = {}

	for _, model in ipairs(folder:GetChildren()) do
		local prompt = model:IsA("Model") and getPrompt(model)
		local adornee = prompt and prompt.Parent
		local rarity = prompt and getRarity(model)

		if adornee and adornee:IsA("BasePart") and enabledRarities[rarity] ~= false then
			seen[model] = true

			if not espObjects[model] then
				local color = RARITY_COLORS[rarity] or COLOR_TEXT

				local highlight = Instance.new("Highlight")
				highlight.FillColor = color
				highlight.OutlineColor = Color3.new(1, 1, 1)
				highlight.FillTransparency = 0.5
				highlight.Parent = model

				local billboard = Instance.new("BillboardGui")
				billboard.Size = UDim2.fromOffset(160, 24)
				billboard.StudsOffset = Vector3.new(0, 4, 0)
				billboard.AlwaysOnTop = true
				billboard.Adornee = adornee
				billboard.Parent = adornee

				local label = createLabel(billboard, string.gsub(model.Name, "^Table_", "") .. " [" .. rarity .. "]", 12, color, Enum.Font.GothamBold)
				label.Size = UDim2.new(1, 0, 1, 0)
				label.TextXAlignment = Enum.TextXAlignment.Center
				label.TextStrokeTransparency = 0.4

				espObjects[model] = { highlight, billboard }
			end
		end
	end

	for model, objects in pairs(espObjects) do
		if not seen[model] then
			for _, object in ipairs(objects) do
				pcall(object.Destroy, object)
			end

			espObjects[model] = nil
		end
	end
end

---Turn full bright on or off.
---@param state boolean
local function setFullBright(state)
	if state then
		lightingBackup = lightingBackup or {
			Ambient = lightingService.Ambient,
			Brightness = lightingService.Brightness,
			ClockTime = lightingService.ClockTime,
			GlobalShadows = lightingService.GlobalShadows,
		}

		lightingService.Ambient = Color3.new(1, 1, 1)
		lightingService.Brightness = 2
		lightingService.ClockTime = 14
		lightingService.GlobalShadows = false
	elseif lightingBackup then
		for property, value in pairs(lightingBackup) do
			lightingService[property] = value
		end

		lightingBackup = nil
	end
end

