-- Quote a string so it can be embedded in generated code.
local function quote(text)
	local escaped = text:gsub('[%c"\\]', function(char)
		return string.format("\\%03d", string.byte(char))
	end)

	return '"' .. escaped .. '"'
end

local function setStatus(text, color)
	if label then
		label.Text = text
		label.TextColor3 = color or TEXT
	end
end

local function finish(text, color)
	finished = true
	shared.PityHopRunning = nil
	setStatus(text, color)

	if button then
		button.Text = "Close"
		button.BackgroundColor3 = Color3.fromRGB(48, 48, 68)
	end
end

