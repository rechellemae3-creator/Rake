---Add a grid of on/off chips that share one state table.
---@param page Instance
---@param names table
---@param stateTable table
---@param colors table?
---@param onChange function?
local function addChips(page, names, stateTable, colors, onChange)
	local columns = 3
	local rows = math.ceil(#names / columns)

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, rows * 28)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = nextOrder(page)
	holder.Parent = page

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / columns, -4, 0, 24)
	grid.CellPadding = UDim2.fromOffset(4, 4)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = holder

	for index, name in ipairs(names) do
		local chip = Instance.new("TextButton")
		chip.LayoutOrder = index
		chip.BorderSizePixel = 0
		chip.Text = name
		chip.Font = Enum.Font.GothamBold
		chip.TextSize = 10
		chip.Parent = holder
		corner(chip, 5)

		local function refresh()
			local on = stateTable[name] ~= false
			chip.BackgroundColor3 = on and COLOR_ON or COLOR_OFF
			chip.TextColor3 = (on and colors and colors[name]) or COLOR_TEXT
		end

		track(chip.MouseButton1Click:Connect(function()
			stateTable[name] = stateTable[name] == false
			refresh()

			if onChange then
				pcall(onChange)
			end
		end))

		refresh()
	end
end

